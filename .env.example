# Copy to .env and fill in values
APP_NAME=genai-agents
ENVIRONMENT=dev

# --- AWS Bedrock (the only LLM provider) ---
# Uses the standard AWS credential chain (env vars, shared config, or IAM role);
# no API key lives here. The execution role/user needs bedrock:InvokeModel.
LLM_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
# Generation: Amazon Nova (usually via a region-prefixed inference profile id).
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_CHEAP_MODEL=us.amazon.nova-micro-v1:0     # tiering: cheap tier
# Embeddings: Amazon Titan Text Embeddings V2 (Nova has no embeddings model).
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSION=1024

# --- RAG vector store ---
# "in_memory" (default) or "s3_vectors" (Amazon S3 Vectors, managed via SDK).
VECTOR_BACKEND=in_memory
# S3_VECTORS_BUCKET=genai-agents-vectors
# S3_VECTORS_INDEX=docs
RETRIEVAL_TOP_K=4

ENABLE_GUARDRAILS=true

# Conversation memory backend: "in_memory" (default) or "agentcore" (managed,
# short- + long-term context via Amazon Bedrock AgentCore Memory).
MEMORY_BACKEND=in_memory
# AGENTCORE_MEMORY_ID=          # required when MEMORY_BACKEND=agentcore
# AGENTCORE_ACTOR_ID=user       # logical end-user id for AgentCore Memory
MEMORY_WINDOW=6

# USD per 1k tokens
COST_PER_1K_INPUT_TOKENS=0.00015
COST_PER_1K_OUTPUT_TOKENS=0.0006

LOG_LEVEL=INFO
