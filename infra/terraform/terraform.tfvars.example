region      = "us-east-1"
environment = "dev"
project     = "genai-agents"

# AWS Bedrock is the only provider. Auth is via the task role (bedrock:InvokeModel);
# there are no API keys or Secrets Manager entries to manage.
llm_provider            = "bedrock"
bedrock_model_id        = "us.amazon.nova-pro-v1:0"
bedrock_embedding_model = "amazon.titan-embed-text-v2:0"

enable_guardrails = true
desired_count     = 1
task_cpu          = 512
task_memory       = 1024
